<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.group37.sentencebuilder.ui.SettingsController"
      styleClass="page-root" spacing="0">
    <Label text="PROJECT" styleClass="section-eyebrow"/>
    <Label text="Settings &amp; About" styleClass="section-heading"/>
    <Label styleClass="section-lead" wrapText="true"
           text="Credits and stack overview. No preferences are stored in this UI-only build."/>

    <VBox spacing="20" styleClass="content-card content-card-elevated" maxWidth="640">
        <Label text="Application" styleClass="card-title"/>
        <VBox styleClass="about-block">
            <Label text="Sentence Builder" styleClass="about-title"/>
            <Label styleClass="about-body" wrapText="true"
                   text="Experimental system for building a corpus from text sources and generating sentences from statistical patterns."/>
        </VBox>
        <Separator styleClass="settings-sep"/>
        <VBox styleClass="about-block">
            <Label text="Team" styleClass="about-title"/>
            <Label styleClass="about-body" wrapText="true"
                   text="Group 37 — Bianca, Cortland, Huy Nhat, Sebastian, Asher, Amrita. Advisor: John Cole."/>
        </VBox>
        <Separator styleClass="settings-sep"/>
        <VBox styleClass="about-block">
            <Label text="Stack" styleClass="about-title"/>
            <Label styleClass="about-body" wrapText="true"
                   text="Java · JavaFX (this UI) · MySQL (backend). IDE: IntelliJ."/>
        </VBox>
    </VBox>
</VBox>
