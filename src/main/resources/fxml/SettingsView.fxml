<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.group37.sentencebuilder.ui_layer.SettingsController"
      styleClass="page-root settings-page-root" spacing="20" maxWidth="Infinity">

    <VBox styleClass="page-section-panel content-card-elevated settings-hero-panel" spacing="10" maxWidth="Infinity">
        <Label text="Settings &amp; About" styleClass="section-heading section-heading-hero"/>
        <Label styleClass="section-lead settings-hero-lead" wrapText="true" maxWidth="Infinity"
               text="Tune how Sentence Builder looks and feels. Appearance is saved app-wide. Sign out when you are done on a shared machine."/>
    </VBox>

    <VBox styleClass="page-section-panel settings-columns-panel" maxWidth="Infinity" spacing="0">
        <GridPane styleClass="settings-two-col" hgap="24" vgap="0" maxWidth="Infinity">
        <columnConstraints>
            <ColumnConstraints hgrow="ALWAYS" minWidth="280" prefWidth="400" maxWidth="520"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="280" prefWidth="400" maxWidth="520"/>
        </columnConstraints>

        <!-- Appearance -->
        <VBox spacing="0" styleClass="settings-inner-card settings-appearance-card"
               GridPane.columnIndex="0" GridPane.rowIndex="0" maxWidth="Infinity">
            <HBox styleClass="settings-card-header" alignment="CENTER_LEFT" spacing="12">
                <Label text="◐" styleClass="settings-card-icon" minWidth="40" alignment="CENTER"/>
                <VBox spacing="4">
                    <Label text="Appearance" styleClass="card-title settings-card-title"/>
                    <Label text="Theme, typeface, and reading size" styleClass="card-subtitle card-subtitle-muted" wrapText="true"/>
                </VBox>
            </HBox>
            <Separator styleClass="settings-sep"/>

            <VBox spacing="16" styleClass="settings-pref-body">
                <VBox spacing="8">
                    <Label text="Theme" styleClass="field-label"/>
                    <ComboBox fx:id="themeCombo" styleClass="combo-styled settings-pref-combo" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="8">
                    <Label text="Font family" styleClass="field-label"/>
                    <ComboBox fx:id="fontCombo" styleClass="combo-styled settings-pref-combo" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="8">
                    <Label text="Font size" styleClass="field-label"/>
                    <ComboBox fx:id="fontSizeCombo" styleClass="combo-styled settings-pref-combo" maxWidth="Infinity"/>
                </VBox>
            </VBox>
        </VBox>

        <!-- About -->
        <VBox spacing="0" styleClass="settings-inner-card settings-about-column-card"
               GridPane.columnIndex="1" GridPane.rowIndex="0" maxWidth="Infinity">
            <HBox styleClass="settings-card-header" alignment="CENTER_LEFT" spacing="12">
                <Label text="ⓘ" styleClass="settings-card-icon" minWidth="40" alignment="CENTER"/>
                <VBox spacing="4">
                    <Label text="About" styleClass="card-title settings-card-title"/>
                    <Label text="Project, team, and stack" styleClass="card-subtitle card-subtitle-muted" wrapText="true"/>
                </VBox>
            </HBox>
            <Separator styleClass="settings-sep"/>

            <VBox spacing="18" styleClass="settings-about-body">
                <VBox styleClass="about-block settings-about-chip" spacing="6">
                    <Label text="Application" styleClass="about-title"/>
                    <Label styleClass="about-body" wrapText="true"
                           text="Sentence Builder — corpus import, statistical patterns, and generated text in one desktop app."/>
                </VBox>
                <VBox styleClass="about-block settings-about-chip" spacing="6">
                    <Label text="Team" styleClass="about-title"/>
                    <Label styleClass="about-body" wrapText="true"
                           text="Group 37 — Bianca, Cortland, Huy Nhat, Sebastian, Asher, Amrita. Advisor: John Cole."/>
                </VBox>
                <VBox styleClass="about-block settings-about-chip" spacing="6">
                    <Label text="Stack" styleClass="about-title"/>
                    <Label styleClass="about-body" wrapText="true"
                           text="Java · JavaFX · MySQL. Built with IntelliJ."/>
                </VBox>
                <VBox styleClass="about-block settings-about-chip" spacing="6">
                    <Label text="Contact" styleClass="about-title"/>
                    <Hyperlink fx:id="contactMailHyperlink" onAction="#onContactMailClicked"
                               styleClass="about-mail-link" wrapText="true"/>
                </VBox>
            </VBox>
        </VBox>
        </GridPane>
    </VBox>

    <HBox styleClass="page-section-panel content-card-elevated settings-session-panel" alignment="CENTER_LEFT" spacing="24" maxWidth="Infinity">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Session" styleClass="card-title"/>
            <Label styleClass="card-subtitle card-subtitle-muted" wrapText="true"
                   text="Return to the login screen. Your theme preferences stay on this device."/>
        </VBox>
        <Region HBox.hgrow="NEVER"/>
        <Button text="Log out" onAction="#onLogoutClicked"
                styleClass="button logout-button" minWidth="120"/>
    </HBox>
</VBox>
