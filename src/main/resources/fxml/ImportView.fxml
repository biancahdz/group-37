<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.group37.sentencebuilder.ui.ImportController"
      styleClass="page-root-wide" spacing="0" maxWidth="Infinity">
    <Label text="DATA IN" styleClass="section-eyebrow section-eyebrow-primary"/>
    <Label text="Import corpus" styleClass="section-heading"/>
    <Label styleClass="section-lead" wrapText="true"
           text="Choose a plain-text file and run a staged import. Controls below are UI-only until your importer service is bound."/>

    <VBox spacing="16" styleClass="content-card">
        <Label text="File" styleClass="card-title"/>
        <Label text="Select a document, then start the import workflow." styleClass="card-subtitle"/>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Button text="Choose file…" onAction="#onChooseFile" styleClass="secondary-button"/>
            <Button text="Import" onAction="#onImport" styleClass="primary-button"/>
        </HBox>
        <VBox styleClass="form-row-tight">
            <Label text="Selected" styleClass="field-label"/>
            <Label fx:id="selectedFileLabel" styleClass="status-label" text="No file selected"/>
        </VBox>
        <Separator styleClass="section-divider"/>
        <VBox styleClass="form-row-tight">
            <Label text="Progress" styleClass="field-label"/>
            <ProgressBar fx:id="importProgress" styleClass="progress-themed" maxWidth="Infinity" prefHeight="10"/>
            <Label fx:id="importStatusLabel" styleClass="status-label" text=""/>
        </VBox>
    </VBox>

    <VBox spacing="14" styleClass="content-card content-card-elevated">
        <VBox.margin>
            <Insets top="18"/>
        </VBox.margin>
        <Label text="Recent imports" styleClass="card-title"/>
        <Label text="Representative rows for layout — swap for live query results." styleClass="card-subtitle"/>
        <TableView fx:id="importTable" styleClass="table-clean" minHeight="200" prefHeight="360">
            <columns>
                <TableColumn fx:id="colFile" text="FILE" prefWidth="200"/>
                <TableColumn fx:id="colDate" text="IMPORTED" prefWidth="180"/>
                <TableColumn fx:id="colSentences" text="SENTENCES" prefWidth="110"/>
                <TableColumn fx:id="colWords" text="WORDS" prefWidth="110"/>
                <TableColumn fx:id="colStatus" text="STATUS" prefWidth="120"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
