<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.group37.sentencebuilder.ui.AutocompleteController"
      styleClass="page-root" spacing="0">
    <Label text="TYPEAHEAD" styleClass="section-eyebrow section-eyebrow-teal"/>
    <Label text="Auto-complete" styleClass="section-heading"/>
    <Label styleClass="section-lead" wrapText="true"
           text="Mock suggestions narrow as you type. Tap a chip to append — swap the data source when the model is ready."/>

    <VBox spacing="14" styleClass="content-card">
        <Label text="Composer" styleClass="card-title"/>
        <Label text="Prefix filters the suggestion list below." styleClass="card-subtitle"/>
        <TextField fx:id="prefixField" promptText="Start typing a word…"/>
        <Label fx:id="hintLabel" styleClass="status-label" wrapText="true"/>
    </VBox>

    <VBox spacing="12" styleClass="content-card content-card-elevated" VBox.vgrow="ALWAYS">
        <VBox.margin>
            <Insets top="24"/>
        </VBox.margin>
        <Label text="Suggestions" styleClass="card-title"/>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" minHeight="200">
            <FlowPane fx:id="suggestionsPane" hgap="10" vgap="10" prefWrapLength="780"
                      style="-fx-padding: 2 0 8 0;"/>
        </ScrollPane>
    </VBox>
</VBox>
